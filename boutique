js = r'''const products=[
 {id:1,name:"Sac Studio",desc:"Coton premium · Édition 2026",price:59.90,emoji:"👜",cls:"p1"},
 {id:2,name:"Bouteille Pure",desc:"Acier inoxydable · 500 ml",price:24.90,emoji:"🧴",cls:"p2"},
 {id:3,name:"Casquette Luma",desc:"Coton bio · Taille ajustable",price:29.90,emoji:"🧢",cls:"p3"},
 {id:4,name:"Carnet Minimal",desc:"Papier recyclé · 160 pages",price:14.90,emoji:"📓",cls:"p4"}
];
let cart=JSON.parse(localStorage.getItem("luma-cart")||"[]");
const $=s=>document.querySelector(s);
const money=n=>n.toLocaleString("fr-FR",{style:"currency",currency:"EUR"});
function renderProducts(list=products){
 $("#products").innerHTML=list.map(p=>`<article class="product"><div class="product-img ${p.cls}">${p.emoji}</div><div class="product-info"><h3>${p.name}</h3><p>${p.desc}</p><div class="price-row"><span class="price">${money(p.price)}</span><button class="add" onclick="addToCart(${p.id})">+</button></div></div></article>`).join("");
}
function addToCart(id){const item=cart.find(x=>x.id===id);item?item.qty++:cart.push({id,qty:1});save();toast("Produit ajouté au panier");}
function save(){localStorage.setItem("luma-cart",JSON.stringify(cart));renderCart();}
function renderCart(){
 const count=cart.reduce((a,x)=>a+x.qty,0);$("#cartCount").textContent=count;
 let total=0;
 if(!cart.length){$("#cartItems").innerHTML='<div style="text-align:center;color:#777;padding:50px 10px">Ton panier est vide.</div>'}
 else{$("#cartItems").innerHTML=cart.map(x=>{const p=products.find(y=>y.id===x.id);total+=p.price*x.qty;return `<div class="cart-line"><div class="mini ${p.cls}">${p.emoji}</div><div style="flex:1"><strong>${p.name}</strong><span>${money(p.price)}</span><div class="qty" style="margin-top:8px"><button onclick="changeQty(${p.id},-1)">−</button> <b>${x.qty}</b> <button onclick="changeQty(${p.id},1)">+</button></div></div></div>`}).join("")}
 $("#cartTotal").textContent=money(total);$("#payAmount").textContent=money(total);
}
function changeQty(id,d){const x=cart.find(y=>y.id===id);if(!x)return;x.qty+=d;if(x.qty<=0)cart=cart.filter(y=>y.id!==id);save();}
function toast(t){const el=$("#toast");el.textContent=t;el.classList.add("show");setTimeout(()=>el.classList.remove("show"),1800)}
$("#sort").addEventListener("change",e=>{let a=[...products];if(e.target.value==="low")a.sort((x,y)=>x.price-y.price);if(e.target.value==="high")a.sort((x,y)=>y.price-x.price);renderProducts(a)});
function openCart(){$("#drawer").classList.add("open");$("#overlay").classList.add("show")}
function closeCart(){$("#drawer").classList.remove("open");$("#overlay").classList.remove("show")}
$("#openCart").onclick=openCart;$("#closeCart").onclick=closeCart;$("#overlay").onclick=closeCart;
$("#checkoutBtn").onclick=()=>{if(!cart.length)return toast("Ton panier est vide");$("#paymentModal").classList.add("show")};
$("#closePayment").onclick=()=>$("#paymentModal").classList.remove("show");
$("#paymentForm").onsubmit=e=>{e.preventDefault();$("#paymentModal").classList.remove("show");cart=[];save();closeCart();toast("Commande de démonstration validée ✓")};
renderProducts();renderCart();'''

